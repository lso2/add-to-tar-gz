// tray.rc: resources of AddToTarGzTray.exe: the tgz icon, the Settings window with its footer, and the version
// information.
// Globals: none. Doc: docs/notes/src/tray/tray.rc.md
#include <windows.h>
#include "resource_ids.h"
#include "tray_ids.h"
#include "version.h"

IDI_TGZ ICON "tgz.ico"

// GitHub's official mark, embedded when icon\github-mark.png exists (AddToTarGzTray.vcxproj).
#ifdef ATG_HAS_GITHUB_MARK
IDR_GITHUB_MARK RCDATA "github-mark.png"
#endif

IDD_SETTINGS DIALOGEX 0, 0, 260, 310
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "AddToTarGz Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Archive extension", -1, 7, 7, 246, 28
    AUTORADIOBUTTON ".tar.gz", IDC_EXT_TARGZ, 15, 19, 70, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON ".tgz", IDC_EXT_TGZ, 95, 19, 70, 10
    GROUPBOX        "Compression level", -1, 7, 40, 246, 28
    AUTORADIOBUTTON "Fastest (1)", IDC_LEVEL_1, 15, 52, 70, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Normal (5)", IDC_LEVEL_5, 95, 52, 70, 10
    AUTORADIOBUTTON "Maximum (9)", IDC_LEVEL_9, 175, 52, 74, 10
    GROUPBOX        "Explorer menu", -1, 7, 73, 246, 126
    AUTOCHECKBOX    "Group the items in an AddToTarGz submenu", IDC_SUBMENU, 15, 85, 230, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Show the AddToTarGz icon", IDC_ICONS, 15, 97, 230, 10, WS_TABSTOP
    LTEXT           "Items", -1, 15, 111, 230, 8
    AUTOCHECKBOX    "", IDC_ITEM_ADD, 23, 122, 222, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_ITEM_ADD_OTHER, 23, 134, 222, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_ITEM_EXTRACT_HERE, 23, 146, 222, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_ITEM_EXTRACT_FOLDER, 23, 158, 222, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_ITEM_EXTRACT_TO, 23, 170, 222, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_ITEM_SETTINGS, 23, 182, 222, 10, WS_TABSTOP
    GROUPBOX        "Tray icon", -1, 7, 204, 246, 28
    AUTOCHECKBOX    "Show the tray icon and start it at sign-in", IDC_TRAY, 15, 216, 230, 10, WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 91, 242, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 147, 242, 50, 14
    PUSHBUTTON      "Apply", IDC_APPLY, 203, 242, 50, 14
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 7, 264, 246, 1
    LTEXT           "", IDC_VERSION, 7, 274, 64, 8
    LTEXT           "", IDC_UPDATE_STATUS, 73, 274, 108, 8, SS_NOTIFY
    PUSHBUTTON      "", IDC_DOWNLOAD, 183, 271, 70, 14, NOT WS_VISIBLE | WS_GROUP
    CONTROL         "GitHub", IDC_GITHUB, "Button", BS_OWNERDRAW | WS_TABSTOP, 7, 290, 50, 12
    PUSHBUTTON      "Buy me a coffee", IDC_COFFEE, 171, 289, 82, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION ATG_VERSION_MAJOR, ATG_VERSION_MINOR, ATG_VERSION_PATCH, 0
PRODUCTVERSION ATG_VERSION_MAJOR, ATG_VERSION_MINOR, ATG_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "PlexPixel"
            VALUE "FileDescription", "AddToTarGz tray icon and settings"
            VALUE "FileVersion", ATG_VERSION_STRING
            VALUE "InternalName", "AddToTarGzTray"
            VALUE "LegalCopyright", "Copyright (C) 2025-2026 PlexPixel. GPLv3."
            VALUE "OriginalFilename", "AddToTarGzTray.exe"
            VALUE "ProductName", "AddToTarGz"
            VALUE "ProductVersion", ATG_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
